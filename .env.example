# ---- Groq API ----
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=allam-2-7b

# ---- OpenTelemetry Collector ----
# OTLP/HTTP endpoint used by the SDK (local collector on 4318)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=llm-observability-lab

# ---- Langfuse (self-hosted, via collector) ----
# Get these from your Langfuse UI: Settings -> API Keys -> Create new API keys
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_BASE_URL="http://localhost:3000"

# ---- Arize Phoenix (self-hosted, via collector) ----
PHOENIX_HOST=http://localhost:6006
PHOENIX_PROJECT=llm-observability-lab

# ---- LangSmith (SaaS, authenticated OTLP) ----
LANGSMITH_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
LANGSMITH_PROJECT=llm-observability-lab

# ---- Pricing (USD per 1M tokens; used for *estimated* cost only) ----
# Premium-model-level pricing so dashboard cost numbers are visually meaningful.
PRICE_INPUT_PER_M=5.00
PRICE_OUTPUT_PER_M=15.00

# ---- Safety ----
# Set to "1" to allow live Groq API calls in example scripts.
ALLOW_LIVE_CALLS=0