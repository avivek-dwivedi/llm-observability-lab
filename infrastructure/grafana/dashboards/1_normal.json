          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Failed Retries",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_obs_llm_api_attempts_total{workflow=\"normal\",outcome!=\"success\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Request Rate (Success vs Errors)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (llm_obs_llm_requests_total{workflow=\"normal\"})",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Latency P50 / P90 / P95 / P99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (llm_obs_llm_request_duration_seconds_bucket{workflow=\"normal\",result=\"success\"}))",
          "refId": "A",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (llm_obs_llm_request_duration_seconds_bucket{workflow=\"normal\",result=\"success\"}))",
          "refId": "B",
          "legendFormat": "P90"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (llm_obs_llm_request_duration_seconds_bucket{workflow=\"normal\",result=\"success\"}))",
          "refId": "C",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (llm_obs_llm_request_duration_seconds_bucket{workflow=\"normal\",result=\"success\"}))",
          "refId": "D",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Cost Over Time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_obs_llm_estimated_cost_usd_USD_total{workflow=\"normal\"})",
          "refId": "A",
          "legendFormat": "cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Token Consumption (Input vs Output)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_obs_llm_tokens_total{workflow=\"normal\",token_type=\"input\"})",
          "refId": "A",
          "legendFormat": "Input"
        },
        {
          "expr": "sum(llm_obs_llm_tokens_total{workflow=\"normal\",token_type=\"output\"})",
          "refId": "B",
          "legendFormat": "Output"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "API Attempts vs Successful",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_obs_llm_api_attempts_total{workflow=\"normal\"})",
          "refId": "A",
          "legendFormat": "Total attempts"
        },
        {
          "expr": "sum(llm_obs_llm_requests_total{workflow=\"normal\",result=\"success\"})",
          "refId": "B",
          "legendFormat": "Successful"
        },
        {
          "expr": "sum(llm_obs_llm_api_attempts_total{workflow=\"normal\",outcome!=\"success\"})",
          "refId": "C",
          "legendFormat": "Failed attempts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Errors by Type",
      "gridPos": {
        "h": 8,
