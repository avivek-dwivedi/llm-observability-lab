        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(llm_obs_llm_request_duration_seconds_sum{workflow=\"normal\",result=\"success\"}) / clamp_min(sum(llm_obs_llm_request_duration_seconds_count{workflow=\"normal\",result=\"success\"}), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
