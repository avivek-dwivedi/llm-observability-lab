          "expr": "histogram_quantile(0.90, sum by (le) (llm_obs_llm_request_duration_seconds_bucket{workflow=\"normal\",result=\"success\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
